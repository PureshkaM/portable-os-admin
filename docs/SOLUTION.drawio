  </diagram><diagram name="Архитектура" id="p2"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="1800" math="0" shadow="0" adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="&lt;b&gt;Архитектура развёртывания и зоны доверия&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1400" height="40" as="geometry"/></mxCell><mxCell id="v2" value="По SOLUTION.md, блок 5. Цифры на стрелках — каналы из таблицы 5.2. Зелёная линия — канал с криптографической защитой; синяя — внутри туннеля VPN; серый пунктир — физическая передача; красный пунктир — предложение проверки." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="2200" height="40" as="geometry"/></mxCell><mxCell id="v3" value="Офлайн: сейф" style="swimlane;startSize=30;fillColor=#E1D5E7;strokeColor=#9673A6;html=1;fontSize=15;fontStyle=1;swimlaneFillColor=#FFFFFF;rounded=1;" vertex="1" parent="1"><mxGeometry x="1770" y="1000" width="780" height="330" as="geometry"/></mxCell><mxCell id="v4" value="&lt;b&gt;Нулевой администратор — основная копия&lt;/b&gt;&lt;br&gt;Рутокен ЭЦП: ключ корня в чипе; ключи слота 0 и депонирования за PIN" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;" vertex="1" parent="v3"><mxGeometry x="20" y="45" width="480" height="70" as="geometry"/></mxCell><mxCell id="v5" value="&lt;b&gt;Нулевой администратор — резервная копия&lt;/b&gt;&lt;br&gt;файл под фразой 33 знака" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;" vertex="1" parent="v3"><mxGeometry x="20" y="130" width="480" height="60" as="geometry"/></mxCell><mxCell id="v6" value="Паспорт организации: отпечатки корней" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;" vertex="1" parent="v3"><mxGeometry x="20" y="205" width="480" height="40" as="geometry"/></mxCell><mxCell id="v7" value="Подключаются только на время привилегированного действия, токен и файл — порознь" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#F5F5F5;strokeColor=#BBBBBB;" vertex="1" parent="v3"><mxGeometry x="20" y="260" width="480" height="50" as="geometry"/></mxCell><mxCell id="v8" value="Чужая среда (недоверенная)" style="swimlane;startSize=30;fillColor=#F8CECC;strokeColor=#B85450;html=1;fontSize=15;fontStyle=1;swimlaneFillColor=#FFFFFF;rounded=1;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="520" height="720" as="geometry"/></mxCell><mxCell id="v9" value="Компьютер-хозяин: процессор, память, клавиатура при загрузке" style="swimlane;startSize=30;fillColor=#FFFFFF;strokeColor=#B85450;html=1;fontSize=15;fontStyle=1;swimlaneFillColor=#FFFFFF;rounded=1;" vertex="1" parent="v8"><mxGeometry x="20" y="45" width="480" height="470" as="geometry"/></mxCell><mxCell id="v10" value="&lt;b&gt;Носитель&lt;/b&gt; (флешка или токен)&lt;br&gt;система в памяти: окно «Подключение», служба доступа, сетевой экран по стадиям, клиенты VPN и RDP/VNC/SSH/RuDesktop; хранилище LUKS; журналы" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="v9"><mxGeometry x="20" y="45" width="440" height="130" as="geometry"/></mxCell><mxCell id="v11" value="Диски хозяина не монтируются; входящих соединений нет; данных на носителе нет" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#F5F5F5;strokeColor=#BBBBBB;" vertex="1" parent="v9"><mxGeometry x="20" y="190" width="440" height="50" as="geometry"/></mxCell><mxCell id="v12" value="Сотрудник: фраза или PIN, TOTP на телефоне, пароль рабочего места" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#F5F5F5;strokeColor=#BBBBBB;" vertex="1" parent="v9"><mxGeometry x="20" y="260" width="440" height="50" as="geometry"/></mxCell><mxCell id="v13" value="Токен рабочего места (из белого списка)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;" vertex="1" parent="v9"><mxGeometry x="20" y="330" width="440" height="40" as="geometry"/></mxCell><mxCell id="v14" value="Сеть гостиницы, кафе; портал входа" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;" vertex="1" parent="v8"><mxGeometry x="20" y="560" width="480" height="60" as="geometry"/></mxCell><mxCell id="v15" value="Интернет" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fontSize=15;fillColor=#F5F5F5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="640" y="560" width="220" height="130" as="geometry"/></mxCell><mxCell id="v16" value="Внешний МЭ" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#333333;fontColor=#FFFFFF;horizontal=0;" vertex="1" parent="1"><mxGeometry x="930" y="160" width="40" height="1100" as="geometry"/></mxCell><mxCell id="v17" value="DMZ компании" style="swimlane;startSize=30;fillColor=#FFF2CC;strokeColor=#D6B656;html=1;fontSize=15;fontStyle=1;swimlaneFillColor=#FFFFFF;rounded=1;" vertex="1" parent="1"><mxGeometry x="1010" y="120" width="640" height="1120" as="geometry"/></mxCell><mxCell id="v18" value="Сервер доступа (один узел или кластер от трёх, на разных хостах)" style="swimlane;startSize=30;fillColor=#FFFFFF;strokeColor=#D6B656;html=1;fontSize=15;fontStyle=1;swimlaneFillColor=#FFFFFF;rounded=1;" vertex="1" parent="v17"><mxGeometry x="20" y="45" width="600" height="420" as="geometry"/></mxCell><mxCell id="v19" value="&lt;b&gt;Узел 1&lt;/b&gt;&lt;br&gt;приложение, nginx, PostgreSQL, etcd; запечатан: ключ данных только в памяти" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;" vertex="1" parent="v18"><mxGeometry x="15" y="45" width="180" height="120" as="geometry"/></mxCell><mxCell id="v20" value="&lt;b&gt;Узел 2&lt;/b&gt;&lt;br&gt;приложение, nginx, PostgreSQL, etcd; запечатан: ключ данных только в памяти" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;" vertex="1" parent="v18"><mxGeometry x="210" y="45" width="180" height="120" as="geometry"/></mxCell><mxCell id="v21" value="&lt;b&gt;Узел 3&lt;/b&gt;&lt;br&gt;приложение, nginx, PostgreSQL, etcd; запечатан: ключ данных только в памяти" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;" vertex="1" parent="v18"><mxGeometry x="405" y="45" width="180" height="120" as="geometry"/></mxCell><mxCell id="v22" value="Синхронная репликация, кворум, взаимный TLS в кластерной сети; узел принимается только по разрешению корня" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#F5F5F5;strokeColor=#BBBBBB;" vertex="1" parent="v18"><mxGeometry x="15" y="185" width="570" height="50" as="geometry"/></mxCell><mxCell id="v23" value="Хранит: записи носителей и депонированные копии, реестр администраторов, группы, профили, выпуски, семена TOTP, звенья, CA и список отзыва, резервные копии контейнеров, журнал" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#F5F5F5;strokeColor=#BBBBBB;" vertex="1" parent="v18"><mxGeometry x="15" y="250" width="570" height="70" as="geometry"/></mxCell><mxCell id="v24" value="Защита от DoS: nginx — пределы запросов и соединений; nftables — только 80/443 (SSH — из сети компании); ограниченный пул обработчиков" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#F5F5F5;strokeColor=#BBBBBB;" vertex="1" parent="v18"><mxGeometry x="15" y="335" width="570" height="65" as="geometry"/></mxCell><mxCell id="v25" value="&lt;b&gt;VPN-шлюз&lt;/b&gt;&lt;br&gt;OpenVPN: сертификат от CA сервера, tls-crypt-v2, список отзыва раз в минуту (UDP 1194, запасной TCP 443)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="v17"><mxGeometry x="20" y="500" width="290" height="110" as="geometry"/></mxCell><mxCell id="v26" value="&lt;b&gt;Координатор ViPNet&lt;/b&gt;&lt;br&gt;при провайдере ViPNet" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="v17"><mxGeometry x="330" y="500" width="290" height="110" as="geometry"/></mxCell><mxCell id="v27" value="Хранилище резервных копий сервера (зашифрованы)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;" vertex="1" parent="v17"><mxGeometry x="20" y="640" width="600" height="50" as="geometry"/></mxCell><mxCell id="v28" value="Среда виртуализации (если сервер — ВМ): копия ВМ без памяти бесполезна — сервер запечатан; снимок с памятью — регламент оператора" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#F5F5F5;strokeColor=#BBBBBB;dashed=1;" vertex="1" parent="v17"><mxGeometry x="20" y="720" width="600" height="70" as="geometry"/></mxCell><mxCell id="v29" value="Внутренний МЭ: только к целям" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#333333;fontColor=#FFFFFF;horizontal=0;" vertex="1" parent="1"><mxGeometry x="1690" y="160" width="40" height="1100" as="geometry"/></mxCell><mxCell id="v30" value="Сеть компании" style="swimlane;startSize=30;fillColor=#DAE8FC;strokeColor=#6C8EBF;html=1;fontSize=15;fontStyle=1;swimlaneFillColor=#FFFFFF;rounded=1;" vertex="1" parent="1"><mxGeometry x="1770" y="120" width="780" height="840" as="geometry"/></mxCell><mxCell id="v31" value="Машина администратора" style="swimlane;startSize=30;fillColor=#FFFFFF;strokeColor=#6C8EBF;html=1;fontSize=15;fontStyle=1;swimlaneFillColor=#FFFFFF;rounded=1;" vertex="1" parent="v30"><mxGeometry x="20" y="45" width="360" height="330" as="geometry"/></mxCell><mxCell id="v32" value="&lt;b&gt;Приложение администратора&lt;/b&gt;&lt;br&gt;режимы: администратора / нулевого администратора" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="v31"><mxGeometry x="20" y="45" width="320" height="70" as="geometry"/></mxCell><mxCell id="v33" value="&lt;b&gt;Токен администратора&lt;/b&gt; (Рутокен ЭЦП без флеш-памяти)&lt;br&gt;контейнер: рабочий ключ в чипе + сжатые данные за PIN" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="v31"><mxGeometry x="20" y="130" width="320" height="90" as="geometry"/></mxCell><mxCell id="v34" value="Рабочие места" style="swimlane;startSize=30;fillColor=#FFFFFF;strokeColor=#6C8EBF;html=1;fontSize=15;fontStyle=1;swimlaneFillColor=#FFFFFF;rounded=1;" vertex="1" parent="v30"><mxGeometry x="400" y="45" width="360" height="470" as="geometry"/></mxCell><mxCell id="v35" value="Windows — &lt;b&gt;RDP&lt;/b&gt;; токен пробросом смарт-карты" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;" vertex="1" parent="v34"><mxGeometry x="20" y="45" width="320" height="60" as="geometry"/></mxCell><mxCell id="v36" value="Linux, новая сессия — &lt;b&gt;xrdp&lt;/b&gt;; токен пробросом (проверить)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;" vertex="1" parent="v34"><mxGeometry x="20" y="120" width="320" height="60" as="geometry"/></mxCell><mxCell id="v37" value="Та же сессия с токеном — &lt;b&gt;RuDesktop&lt;/b&gt; (будущее)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;" vertex="1" parent="v34"><mxGeometry x="20" y="195" width="320" height="60" as="geometry"/></mxCell><mxCell id="v38" value="Та же сессия без токена — &lt;b&gt;VNC&lt;/b&gt;; все устройства запрещены" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;" vertex="1" parent="v34"><mxGeometry x="20" y="270" width="320" height="60" as="geometry"/></mxCell><mxCell id="v39" value="Консоль Linux — &lt;b&gt;SSH&lt;/b&gt;; токен на стороне носителя" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;" vertex="1" parent="v34"><mxGeometry x="20" y="345" width="320" height="60" as="geometry"/></mxCell><mxCell id="v40" value="&lt;b&gt;SIEM компании&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="v30"><mxGeometry x="20" y="400" width="360" height="60" as="geometry"/></mxCell><mxCell id="v41" value="Сервер RuDesktop (будущее): доступен только из туннеля" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;" vertex="1" parent="v30"><mxGeometry x="20" y="480" width="360" height="60" as="geometry"/></mxCell><mxCell id="v42" value="Репозитории дистрибутивов (официальные или зеркало компании)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;" vertex="1" parent="v30"><mxGeometry x="20" y="560" width="360" height="60" as="geometry"/></mxCell><mxCell id="v43" value="Пароль рабочего места — свой; куда можно из туннеля, решает внутренний МЭ" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#F5F5F5;strokeColor=#BBBBBB;" vertex="1" parent="v30"><mxGeometry x="400" y="540" width="360" height="60" as="geometry"/></mxCell><mxCell id="e44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#999999;dashed=1;fontSize=13;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v10" target="v14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e45" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#999999;dashed=1;fontSize=13;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v14" target="v15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e46" value="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=2;fontColor=#1B5E20;fontSize=13;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v15" target="v18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e47" value="2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=2;fontColor=#1B5E20;fontSize=13;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v15" target="v25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e48" value="3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#1565C0;strokeWidth=2;fontColor=#0D47A1;fontSize=13;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.8;entryX=0.5;entryY=1;" edge="1" parent="1" source="v25" target="v34"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e49" value="4, 5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#1565C0;strokeWidth=2;fontColor=#0D47A1;fontSize=13;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v25" target="v18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e50" value="6, 7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=2;fontColor=#1B5E20;fontSize=13;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v32" target="v18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e51" value="8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=2;fontColor=#1B5E20;fontSize=13;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v32" target="v34"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e52" value="9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=2;fontColor=#1B5E20;fontSize=13;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="v32" target="v42"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e53" value="11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=2;fontColor=#1B5E20;fontSize=13;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v18" target="v40"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e54" value="12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=2;fontColor=#1B5E20;fontSize=13;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v18" target="v27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e55" value="13" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#999999;dashed=1;fontSize=13;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v3" target="v31"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e56" value="3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#1565C0;strokeWidth=2;fontColor=#0D47A1;fontSize=13;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v25" target="v41"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e57" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#999999;dashed=1;fontSize=13;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v13" target="v10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v58" value="&lt;div&gt;&lt;b&gt;Каналы&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;1.&lt;/b&gt; носитель → сервер доступа (интернет): проба портала, вход, активация, журнал, карточка, принудительный выпуск, этап 1 — доступ к VPN до DMZ — TLS 1.3 с закреплённым ключом; запрос подписан ключом носителя с одноразовым числом; ответы подписаны&lt;/div&gt;&lt;div&gt;&lt;b&gt;2.&lt;/b&gt; носитель → VPN-шлюз: туннель ViPNet (если есть у компании) или OpenVPN (сертификат на сутки, tls-crypt-v2)&lt;/div&gt;&lt;div&gt;&lt;b&gt;3.&lt;/b&gt; носитель → рабочее место / сервер RuDesktop — в туннеле; отпечаток из профиля, профиль подписан администратором носителя&lt;/div&gt;&lt;div&gt;&lt;b&gt;4.&lt;/b&gt; носитель → сервер доступа в туннеле: этап 2 — профили подключения (подпись администратора носителя), плановый выпуск (подпись + целостность образа)&lt;/div&gt;&lt;div&gt;&lt;b&gt;5.&lt;/b&gt; шлюз → сервер доступа: список отзыва раз в минуту&lt;/div&gt;&lt;div&gt;&lt;b&gt;6.&lt;/b&gt; программа → сервер: команды, распечатывание, резервные копии контейнеров, сверка — только из сети компании; подпись + сертификат корня&lt;/div&gt;&lt;div&gt;&lt;b&gt;7.&lt;/b&gt; программа → сервер по SSH: первая настройка, узлы кластера, восстановление — только из сети компании; ключ хоста сверяется с консолью&lt;/div&gt;&lt;div&gt;&lt;b&gt;8.&lt;/b&gt; программа → рабочие места: чтение сертификата для профиля, сверка отпечатка&lt;/div&gt;&lt;div&gt;&lt;b&gt;9.&lt;/b&gt; программа → репозитории: пакеты для сборки (подписи дистрибутива)&lt;/div&gt;&lt;div&gt;&lt;b&gt;10.&lt;/b&gt; узлы кластера между собой: репликация, etcd, распечатывание соседа — взаимный TLS, отдельная сеть&lt;/div&gt;&lt;div&gt;&lt;b&gt;11.&lt;/b&gt; сервер → SIEM: syslog поверх TLS&lt;/div&gt;&lt;div&gt;&lt;b&gt;12.&lt;/b&gt; сервер → хранилище резервных копий: зашифрованные копии&lt;/div&gt;&lt;div&gt;&lt;b&gt;13.&lt;/b&gt; нулевой администратор → программа: токен по USB (PIN открытым текстом — только доверенная машина) или резервный файл&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1380" width="1400" height="267" as="geometry"/></mxCell><mxCell id="v59" value="&lt;div&gt;&lt;b&gt;Линии&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;зелёная&lt;/b&gt;&lt;/font&gt; — канал с криптографической защитой&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#1565C0&quot;&gt;&lt;b&gt;синяя&lt;/b&gt;&lt;/font&gt; — внутри туннеля VPN&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#999999&quot;&gt;&lt;b&gt;серый пунктир&lt;/b&gt;&lt;/font&gt; — физическая передача или сеть без защиты&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#C0392B&quot;&gt;&lt;b&gt;красный пунктир&lt;/b&gt;&lt;/font&gt; — предложение проверки&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1480" y="1380" width="520" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Варианты использования" id="p3"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2500" pageHeight="1500" math="0" shadow="0" adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="&lt;b&gt;Варианты использования&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="40" as="geometry"/></mxCell><mxCell id="v2" value="Номер в скобках — раздел SOLUTION.md. Актёр связан со всеми вариантами группы, к которой ведёт его линия; пунктир со стрелкой — один вариант использует другой. Процессы по дорожкам — на вкладках П1–П12." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="2000" height="30" as="geometry"/></mxCell><mxCell id="v3" value="&lt;b&gt;Решение: защищённый удалённый доступ с переносного носителя&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=15;fillColor=none;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="300" y="110" width="1900" height="1300" as="geometry"/></mxCell><mxCell id="v4" value="Организация и сервер — режим нулевого администратора" style="swimlane;startSize=30;html=1;fontSize=14;fontStyle=1;fillColor=#E1D5E7;strokeColor=#9673A6;rounded=1;swimlaneFillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="330" y="160" width="900" height="520" as="geometry"/></mxCell><mxCell id="v5" value="Первая настройка организации (4.1.1)" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#9673A6;" vertex="1" parent="v4"><mxGeometry x="30" y="45" width="400" height="70" as="geometry"/></mxCell><mxCell id="v6" value="Создание администратора: рядом / далеко (4.1.2)" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#9673A6;" vertex="1" parent="v4"><mxGeometry x="460" y="45" width="400" height="70" as="geometry"/></mxCell><mxCell id="v7" value="Продление и отзыв сертификата (4.1.3)" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#9673A6;" vertex="1" parent="v4"><mxGeometry x="30" y="137" width="400" height="70" as="geometry"/></mxCell><mxCell id="v8" value="Назначение и замена корня, хищение (4.1.6)" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#9673A6;" vertex="1" parent="v4"><mxGeometry x="460" y="137" width="400" height="70" as="geometry"/></mxCell><mxCell id="v9" value="Распечатывание сервера слотом 0 (4.1.5)" style="ellipse;whiteSpace=wrap;html=1;fontSize