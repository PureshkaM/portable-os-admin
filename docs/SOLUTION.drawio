ntSize=10;spacing=14;" vertex="1" parent="v2"><mxGeometry x="1870" y="20" width="170" height="110" as="geometry"/></mxCell><mxCell id="v15" value="Запуск в QEMU: администратор проходит систему сам" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v3"><mxGeometry x="2065" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v16" value="«Опубликовать выпуск»" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v2"><mxGeometry x="2255" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v17" value="release.json (номер растёт), подпись рабочим ключом" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v3"><mxGeometry x="2445" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v18" value="Проверка подписи и сертификата; хранение файлов" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v4"><mxGeometry x="2635" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v19" value="Назначить выпуск своим группам; при уязвимости — поднять минимальный выпуск" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v2"><mxGeometry x="2825" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v20" value="" style="ellipse;html=1;shape=doubleEllipse;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="v2"><mxGeometry x="3078" y="58" width="34" height="34" as="geometry"/></mxCell><mxCell id="e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v5" target="v6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v6" target="v7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBack