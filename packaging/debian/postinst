#!/bin/sh
set -e

VENV=/opt/portable-os-admin/venv
APP=/usr/share/portable-os-admin/app

case "$1" in
    configure)
        if [ ! -x "$VENV/bin/python3" ]; then
            # --system-site-packages: the GUI needs Tkinter, a C extension
            # bound to the system Python (shipped by the python3-tk Depends
            # entry) that pip cannot install into an isolated venv -- this
            # lets the venv see it while textual/cryptography still come
            # from pip below, pinned to the versions this app actually needs.
            python3 -m venv --system-site-packages "$VENV"
        fi
        "$VENV/bin/pip" install --upgrade pip --quiet
        # Build from a throwaway copy, never from $APP itself. Two reasons, both
        # observed rather than theoretical:
        #   - setuptools builds in-tree and then reuses its own build/ directory,
        #     so a second install of the same version installed the *previous*
        #     copy of the sources and the update silently did nothing;
        #   - those build artifacts landed in a directory dpkg owns, unrecorded.
        BUILD_DIR=$(mktemp -d)
        cp -a "$APP/." "$BUILD_DIR/"
        rm -rf "$BUILD_DIR/build"
        # --force-reinstall because pip compares version numbers only, and this
        # package's version does not change on every rebuild. --no-deps keeps it
        # from rebuilding cryptography's Rust extension each time; the second
        # call resolves dependencies normally.
        "$VENV/bin/pip" install --quiet --upgrade --force-reinstall --no-deps "$BUILD_DIR"
        "$VENV/bin/pip" install --quiet "$BUILD_DIR"
        rm -rf "$BUILD_DIR"
        ;;
esac

#DEBHELPER#

exit 0
