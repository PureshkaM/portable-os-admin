#!/bin/sh
set -e

VENV=/opt/portable-os-admin/venv
APP=/usr/share/portable-os-admin/app

case "$1" in
    configure)
        if [ ! -x "$VENV/bin/python3" ]; then
            # --system-site-packages: the GUI needs Tkinter, a C extension
            # bound to the system Python (shipped by the python3-tk Depends
            # entry) that pip cannot install into an isolated venv -- this
            # lets the venv see it while textual/cryptography still come
            # from pip below, pinned to the versions this app actually needs.
            python3 -m venv --system-site-packages "$VENV"
        fi
        "$VENV/bin/pip" install --upgrade pip --quiet
        "$VENV/bin/pip" install --quiet "$APP"
        ;;
esac

#DEBHELPER#

exit 0
