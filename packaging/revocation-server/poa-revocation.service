# generated by portable-os-admin
#
# Служба ресурса отзыва. Слушает только localhost: наружу смотрит обратный
# прокси с TLS, потому что носитель ходит строго по https -- подпись защищает
# ответ от подмены, но по открытому каналу видно, какие носители у организации
# есть и когда они включаются.
[Unit]
Description=Ресурс отзыва переносных носителей
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/sbin/poa-revocation-server.py \
    --key %d/revocation-key \
    --credentials %d \
    --state /var/lib/poa-revocation \
    --db ${POA_DB} \
    --admins /var/lib/poa-revocation/admins \
    --host 127.0.0.1 --port 8081

# База -- PostgreSQL на этой же машине (install.sh пишет POA_DB в
# poa-revocation.service.d/db.conf) или, для стенда, файл sqlite.
Environment=POA_DB=/var/lib/poa-revocation/media.sqlite
# База и список администраторов лежат в /var/lib, а не рядом с ключом: ключ
# служба только читает, а это -- пишет. Список пишется потому, что первый
# администратор заводится по одноразовому коду: сервер разворачивают раньше,
# чем появляется приложение, и на момент установки класть в него нечего.
StateDirectory=poa-revocation

# Ключ отдаётся через учётные данные systemd, а не правами на файл.
#
# Иначе получается противоречие: `DynamicUser=yes` даёт службе временного
# пользователя без всего лишнего -- и он же не может прочитать ключ с правами
# 600 для root. Ослабить права значило бы открыть закрытый ключ всем, кто
# попадёт на машину. Здесь файл читает systemd от root при старте и кладёт
# копию в каталог, видимый только этой службе; на диске он остаётся 600.
LoadCredential=revocation-key:/etc/poa-revocation/revocation-key.pem
# Ключи v3. Пока здесь, до запечатанной связки (этап Э21).
LoadCredential=ca-key:/etc/poa-revocation/ca-key
LoadCredential=ca-cert:/etc/poa-revocation/ca-cert
LoadCredential=data-key:/etc/poa-revocation/data-key
LoadCredential=tls-crypt-v2:/etc/poa-revocation/tls-crypt-v2
Restart=on-failure
RestartSec=5

# Служба держит закрытый ключ, которым подписываются ответы носителям, и
# больше ничего. Поэтому у неё нет своего пользователя в системе, нет доступа
# на запись никуда и нет ничего, что можно было бы использовать дальше, если
# сервер всё-таки взломают.
DynamicUser=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
# AF_UNIX -- сокет PostgreSQL (вход по peer, без пароля).
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
MemoryDenyWriteExecute=yes
# Ключ и список читаются, но не пишутся: отзыв делается заменой файла снаружи,
# а не самой службой.
ReadOnlyPaths=/etc/poa-revocation

[Install]
WantedBy=multi-user.target
