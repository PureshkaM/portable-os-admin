#!/usr/bin/make -f

%:
	dh $@ --with python3

override_dh_auto_configure:

override_dh_auto_build:

override_dh_auto_test:

# The application is installed as an ordinary system Python package rather than
# into a private virtualenv. The virtualenv existed because Debian bookworm
# packaged textual 0.1.13, far too old for the TUI; the TUI is gone and
# cryptography -- now the only third-party import -- ships as
# python3-cryptography. Dropping the venv is what makes this package installable
# with no access to the internet, which was never true while `pip install` ran
# from postinst.
override_dh_auto_install:
	mkdir -p debian/portable-os-admin/usr/lib/python3/dist-packages
	cp -r src/portable_os_admin debian/portable-os-admin/usr/lib/python3/dist-packages/
	find debian/portable-os-admin/usr/lib/python3/dist-packages -name __pycache__ -type d -exec rm -rf {} +
	mkdir -p debian/portable-os-admin/usr/bin
	printf '#!/bin/sh\nexec /usr/bin/python3 -m portable_os_admin.gui.app "$$@"\n' \
		> debian/portable-os-admin/usr/bin/portable-os-admin
	chmod 755 debian/portable-os-admin/usr/bin/portable-os-admin
	mkdir -p debian/portable-os-admin/usr/share/applications
	cp debian/portable-os-admin.desktop debian/portable-os-admin/usr/share/applications/
	# polkit action, the rule naming who may authorise it, and the launcher the
	# action points at. The path inside the .policy file is absolute and must
	# match where the launcher lands, or the desktop falls back to a generic
	# "run /usr/bin/env as root" prompt that names nothing.
	mkdir -p debian/portable-os-admin/usr/share/polkit-1/actions
	cp packaging/polkit/ru.portableosadmin.policy \
		debian/portable-os-admin/usr/share/polkit-1/actions/
	mkdir -p debian/portable-os-admin/usr/share/polkit-1/rules.d
	cp packaging/polkit/49-portable-os-admin.rules \
		debian/portable-os-admin/usr/share/polkit-1/rules.d/
	mkdir -p debian/portable-os-admin/usr/lib/portable-os-admin
	cp packaging/polkit/launch-root debian/portable-os-admin/usr/lib/portable-os-admin/
	chmod 755 debian/portable-os-admin/usr/lib/portable-os-admin/launch-root
