000000;strokeColor=#000000;" vertex="1" parent="v2"><mxGeometry x="230" y="60" width="30" height="30" as="geometry"/></mxCell><mxCell id="v8" value="«Новый профиль»: способ по задаче → адрес → имя пользователя" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v2"><mxGeometry x="355" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v9" value="Подключается к рабочему месту из сети компании" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v3"><mxGeometry x="545" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v10" value="Отдаёт сертификат или ключ хоста" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v4"><mxGeometry x="735" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v11" value="Отпечаток совпал с машиной?" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;spacing=14;" vertex="1" parent="v2"><mxGeometry x="920" y="20" width="170" height="110" as="geometry"/></mxCell><mxCell id="v12" value="Согласованность: у VNC все устройства запрещены" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v3"><mxGeometry x="1115" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v13" value="Ввести отпечаток вручную или разобраться" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v2"><mxGeometry x="1305" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v14" value="Подписывает профиль ключом администратора носителя" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v3"><mxGeometry x="1495" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v15" value="Хранит (только здесь); назначение своим носителям или группам" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v5"><mxGeometry x="1685" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v16" value="Этап 2, через туннель: получает профили, проверяет подпись, держит в памяти" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v6"><mxGeometry x="1875" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v17" value="По сроку сертификата заранее предупреждает об устаревании" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v3"><mxGeometry x="2065" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v18" value="" style="ellipse;html=1;shape=doubleEllipse;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="v3"><mxGeometry x="2318" y="58" width="34" height="34" as="geometry"/></mxCell><mxCell id="e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v7" target="v8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v8" target="v9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v9" target="v10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v10" target="v11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e23" value="нет" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v11" target="v13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e24" value="да" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v11" target="v12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v12" target="v14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v14" target="v15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v15" target="v16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v16" target="v17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v17" target="v18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v30" value="Изменение или удаление профиля действует со следующего входа — перевыпуск носителя не нужен. Взломанный сервер не подменит профиль: подпись администратора носителя." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="860" width="420" height="67" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="П12 Распечатывание" id="p15"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2590" pageHeight="1160" math="0" shadow="0" adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="&lt;b&gt;П12. Распечатывание сервера (4.1.5, 4.2.12)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="2510" height="50" as="geometry"/></mxCell><mxCell id="v2" value="Сервер доступа" style="swimlane;horizontal=0;startSize=150;fillColor=#F5F5F5;html=1;fontSize=13;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="2510" height="150" as="geometry"/></mxCell><mxCell id="v3" value="Соседние узлы кластера" style="swimlane;horizontal=0;startSize=150;fillColor=#E8F4F8;html=1;fontSize=13;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="240" width="2510" height="150" as="geometry"/></mxCell><mxCell id="v4" value="TPM узла" style="swimlane;horizontal=0;startSize=150;fillColor=#FFF0E6;html=1;fontSize=13;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="390" width="2510" height="150" as="geometry"/></mxCell><mxCell id="v5" value="Администратор" style="swimlane;horizontal=0;startSize=150;fillColor=#E8F5E9;html=1;fontSize=13;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="540" width="2510" height="150" as="geometry"/></mxCell><mxCell id="v6" value="Владелец корня" style="swimlane;horizontal=0;startSize=150;fillColor=#FFF9E6;html=1;fontSize=13;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="690" width="2510" height="150" as="geometry"/></mxCell><mxCell id="v7" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="v2"><mxGeometry x="230" y="60" width="30" height="30" as="geometry"/></mxCell><mxCell id="v8" value="Узел запущен — запечатан: секреты на диске зашифрованы" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v2"><mxGeometry x="355" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v9" value="Живые соседи в кластере?" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;spacing=14;" vertex="1" parent="v2"><mxGeometry x="540" y="20" width="170" height="110" as="geometry"/></mxCell><mxCell id="v10" value="Передают ключ данных по взаимному TLS (аренда etcd, узел был жив недавно); событие" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v3"><mxGeometry x="735" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v11" value="Есть TPM?" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;spacing=14;" vertex="1" parent="v2"><mxGeometry x="920" y="20" width="170" height="110" as="geometry"/></mxCell><mxCell id="v12" value="Автораспечатывание; событие" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v4"><mxGeometry x="1115" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v13" value="Носителям — «сервис недоступен»" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v2"><mxGeometry x="1305" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v14" value="Есть контейнер администратора?" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;spacing=14;" vertex="1" parent="v5"><mxGeometry x="1490" y="20" width="170" height="110" as="geometry"/></mxCell><mxCell id="v15" value="Распечатывает слотом 0" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v6"><mxGeometry x="1685" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v16" value="«Сервер запечатан» → «Распечатать»: свой слот → ключ данных по закреплённому TLS с подписью" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v5"><mxGeometry x="1875" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v17" value="Распечатан — работает" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v2"><mxGeometry x="2065" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v18" value="" style="ellipse;html=1;shape=doubleEllipse;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="v2"><mxGeometry x="2318" y="58" width="34" height="34" as="geometry"/></mxCell><mxCell id="e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v7" target="v8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v8" target="v9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e21" value="да" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v9" target="v10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v10" target="v17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e23" value="нет" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v9" target="v11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e24" value="да" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v11" target="v12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v12" target="v17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e26" value="нет" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v11" target="v13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v13" target="v14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e28" value="да" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v14" target="v16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e29" value="нет" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v14" target="v15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v16" target="v17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v15" target="v17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v17" target="v18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v33" value="Простой одиночного сервера до ручного распечатывания — цена защиты от копии ВМ; при наличии TPM разрешено автораспечатывание." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="860" width="420" height="53" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Проверка" id="p16"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1500" math="0" shadow="0" adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="&lt;b&gt;Проверка решения: итоги (раздел 7)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1600" height="40" as="geometry"/></mxCell><mxCell id="v2" value="Сверка с приказом ФСТЭК № 117 и ГОСТ Р 58833-2020 по первоисточникам, ГОСТ Р 57580.1-2017, ГОСТ Р 59548-2022. Карточка — суть, почему это проблема, предложение. Цепочки атак — по методике сборки цепочек из скилла моделирования угроз." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="2000" height="40" as="geometry"/></mxCell><mxCell id="v3" value="&lt;div&gt;&lt;b&gt;Н1 · принято&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Карточку сервера подписывает только нулевой администратор&lt;/b&gt;&lt;/div&gt;&lt;div&gt;Карточка общая для всех носителей: один недобросовестный администратор увёл бы весь парк.&lt;/div&gt;&lt;div&gt;Сделано в П1 и в сущности «Карточка сервера».&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="500" height="200" as="geometry"/></mxCell><mxCell id="v4" value="&lt;div&gt;&lt;b&gt;Н2 · принято&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;«Отозван» подписывает администратор носителя&lt;/b&gt;&lt;/div&gt;&lt;div&gt;Взломанный сервер больше не может стереть весь парк.&lt;/div&gt;&lt;div&gt;Сделано в П8.&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="120" width="500" height="200" as="geometry"/></mxCell><mxCell id="v5" value="&lt;div&gt;&lt;b&gt;Н3 · принято&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Контейнеры администраторов — на токенах&lt;/b&gt;&lt;/div&gt;&lt;div&gt;Ключ в чипе, подпись после PIN; приказ № 117 п. 48, ГОСТ Р 58833 п. 6.18.&lt;/div&gt;&lt;div&gt;Устройство хранения — раздел 9, открыты вопросы 9.3.&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1080" y="120" width="500" height="200" as="geometry"/></mxCell><mxCell id="v6" value="&lt;div&gt;&lt;b&gt;Н4 · принято&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Ключ администратора рождается только у него&lt;/b&gt;&lt;/div&gt;&lt;div&gt;Владелец корня не видит ключей; журнал доказывает авторство.&lt;/div&gt;&lt;div&gt;Сделано в П2.&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1600" y="120" width="500" height="200" as="geometry"/></mxCell><mxCell id="v7" value="&lt;div&gt;&lt;b&gt;Н5 · принято&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Ключ флешки рождается на носителе при активации&lt;/b&gt;&lt;/div&gt;&lt;div&gt;Машина администратора не знает ключей носителей.&lt;/div&gt;&lt;div&gt;Сделано в П4.&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="500" height="200" as="geometry"/></mxCell><mxCell id="v8" value="&lt;div&gt;&lt;b&gt;Н12 · принято&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Один ответ на любой отказ входа&lt;/b&gt;&lt;/div&gt;&lt;div&gt;ГОСТ Р 58833 п. 6.6: результат по каждому фактору не сообщается.&lt;/div&gt;&lt;div&gt;Сделано в П5.&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="380" width="500" height="200" as="geometry"/></mxCell><mxCell id="v9" value="&lt;div&gt;&lt;b&gt;Н13 · организационная&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Разделение ролей в ГИС&lt;/b&gt;&lt;/div&gt;&lt;div&gt;Приказ № 117 п. 48: системный администратор и администратор безопасности — разные люди.&lt;/div&gt;&lt;div&gt;Программа совмещения не навязывает; разделение — мера оператора.&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1080" y="380" width="500" height="200" as="geometry"/></mxCell><mxCell id="v10" value="Закрыты границей ответственности (1.5): Н6 — блокировка сеанса (рабочее место), Н7 — журнал (наша часть — настраиваемый размер), Н9 — заместитель владельца корня, Н10 — BadUSB до загрузки (остаток), Н11 — процесс разработки. Н8 решён: есть ViPNet — пользуемся им, нет — OpenVPN. Пробелы по курсовой И1–И6 решены (раздел 8)." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="2060" height="70" as="geometry"/></mxCell><mxCell id="v11" value="&lt;b&gt;Цепочки атак&lt;/b&gt;" style="text;html=1;align=left;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="750" width="600" height="30" as="geometry"/></mxCell><mxCell id="v12" value="&lt;div&gt;&lt;b&gt;Уведённый парк&lt;/b&gt;&lt;/div&gt;&lt;div&gt;взломана машина администратора → карточка со своим сервером → все носители идут туда&lt;/div&gt;&lt;div&gt;&lt;b&gt;Итог:&lt;/b&gt; отказ в работе всей организации&lt;/div&gt;&lt;div&gt;&lt;b&gt;Закрывает:&lt;/b&gt; Н1&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="790" width="500" height="170" as="geometry"/></mxCell><mxCell id="v13" value="&lt;div&gt;&lt;b&gt;Стёртый парк&lt;/b&gt;&lt;/div&gt;&lt;div&gt;взломан работающий сервер → «отозван» всем, подписанный ключом сервера&lt;/div&gt;&lt;div&gt;&lt;b&gt;Итог:&lt;/b&gt; стёрт весь парк, перевыпуск всех носителей&lt;/div&gt;&lt;div&gt;&lt;b&gt;Закрывает:&lt;/b&gt; Н2&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="790" width="500" height="170" as="geometry"/></mxCell><mxCell id="v14" value="&lt;div&gt;&lt;b&gt;Чужая подпись&lt;/b&gt;&lt;/div&gt;&lt;div&gt;администратор создан «далеко» → владелец корня сохранил его ключ → команды от его имени&lt;/div&gt;&lt;div&gt;&lt;b&gt;Итог:&lt;/b&gt; журнал указывает не на того&lt;/div&gt;&lt;div&gt;&lt;b&gt;Закрывает:&lt;/b&gt; Н4, Н3&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1080" y="790" width="500" height="170" as="geometry"/></mxCell><mxCell id="v15" value="&lt;div&gt;&lt;b&gt;Украденный контейнер&lt;/b&gt;&lt;/div&gt;&lt;div&gt;копия контейнера → подбор пароля → команды от имени администратора&lt;/div&gt;&lt;div&gt;&lt;b&gt;Итог:&lt;/b&gt; полный контроль над его носителями&lt;/div&gt;&lt;div&gt;&lt;b&gt;Закрывает:&lt;/b&gt; Н3&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1600" y="790" width="500" height="170" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>