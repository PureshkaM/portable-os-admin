#!/bin/sh
# Started by pkexec after polkit has authorised the caller.
#
# polkit clears the environment of the program it launches, so the session's
# display is handed in as arguments -- without it the privileged copy has no
# screen and dies with a Tk connection error that explains nothing.
#
# The path of this script is referenced verbatim by
# /usr/share/polkit-1/actions/ru.portableosadmin.policy; moving one without the
# other silently drops back to the generic "run /usr/bin/env" dialog.
set -e

# Four positional arguments, in this order. Wayland sessions matter as much as
# X ones: Tk itself goes through XWayland (so DISPLAY is set), but without
# XDG_RUNTIME_DIR the privileged copy has no session directory to work in.
[ -n "$1" ] && export DISPLAY="$1"
[ -n "$2" ] && export XAUTHORITY="$2"
[ -n "$3" ] && export WAYLAND_DISPLAY="$3"
[ -n "$4" ] && export XDG_RUNTIME_DIR="$4"

# Tells the relaunched copy that it already has the rights it needs, so it does
# not ask polkit again in an endless loop.
export POA_ELEVATED=1

# The package entry point selects system Python and locates the installed code.
# The display arguments above belong to this launcher only.
exec /usr/bin/portable-os-admin
