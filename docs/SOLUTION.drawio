альной машине (4.1.10)" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#82B366;" vertex="1" parent="v15"><mxGeometry x="460" y="45" width="400" height="70" as="geometry"/></mxCell><mxCell id="v18" value="Публикация выпуска и назначение группам (4.1.11)" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#82B366;" vertex="1" parent="v15"><mxGeometry x="30" y="137" width="400" height="70" as="geometry"/></mxCell><mxCell id="v19" value="Принятие выпуска коллеги (4.1.11)" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#82B366;" vertex="1" parent="v15"><mxGeometry x="460" y="137" width="400" height="70" as="geometry"/></mxCell><mxCell id="v20" value="Обмен конфигурациями (4.1.12)" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#82B366;" vertex="1" parent="v15"><mxGeometry x="30" y="229" width="400" height="70" as="geometry"/></mxCell><mxCell id="v21" value="Конфигурация системы защиты (4.1.13)" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#82B366;" vertex="1" parent="v15"><mxGeometry x="460" y="229" width="400" height="70" as="geometry"/></mxCell><mxCell id="v22" value="Профили подключения (4.1.22)" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#82B366;" vertex="1" parent="v15"><mxGeometry x="30" y="321" width="400" height="70" as="geometry"/></mxCell><mxCell id="v23" value="Распечатывание сервера своим слотом (4.1.5)" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#82B366;" vertex="1" parent="v15"><mxGeometry x="460" y="321" width="400" height="70" as="geometry"/></mxCell><mxCell id="v24" value="Работа сотрудника" style="swimlane;startSize=30;html=1;fontSize=14;fontStyle=1;fillColor=#FFF2CC;strokeColor=#D6B656;rounded=1;swimlaneFillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="330" y="780" width="900" height="336" as="geometry"/></mxCell