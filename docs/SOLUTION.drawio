r=none;fillStyle=solid;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460" y="860" width="420" height="67" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="П5 Ежедневный вход" id="p8"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="4870" pageHeight="1160" math="0" shadow="0" adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="&lt;b&gt;П5. Ежедневный вход сотрудника (4.3.2, 4.2.5)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="4790" height="50" as="geometry"/></mxCell><mxCell id="v2" value="Сотрудник" style="swimlane;horizontal=0;startSize=150;fillColor=#F5F5F5;html=1;fontSize=13;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="4790" height="150" as="geometry"/></mxCell><mxCell id="v3" value="Носитель" style="swimlane;horizontal=0;startSize=150;fillColor=#E8F4F8;html=1;fontSize=13;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="240" width="4790" height="150" as="geometry"/></mxCell><mxCell id="v4" value="Сервер доступа" style="swimlane;horizontal=0;startSize=150;fillColor=#FFF0E6;html=1;fontSize=13;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="390" width="4790" height="150" as="geometry"/></mxCell><mxCell id="v5" value="VPN-шлюз" style="swimlane;horizontal=0;startSize=150;fillColor=#E8F5E9;html=1;fontSize=13;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="540" width="4790" height="150" as="geometry"/></mxCell><mxCell id="v6" value="Рабочее место" style="swimlane;horizontal=0;startSize=150;fillColor=#FFF9E6;html=1;fontSize=13;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="690" width="4790" height="150" as="geometry"/></mxCell><mxCell id="v7" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="v2"><mxGeometry x="230" y="60" width="30" height="30" as="geometry"/></mxCell><mxCell id="v8" value="Загрузка с USB; загрузчик берёт рабочий слот" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v2"><mxGeometry x="355" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v9" value="Фраза (у токена — PIN)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v2"><mxGeometry x="545" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v10" value="Фраза верна, компьютер допустим?" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;spacing=14;" vertex="1" parent="v3"><mxGeometry x="730" y="20" width="170" height="110" as="geometry"/></mxCell><mxCell id="v11" value="Восстановление по звонку (П7)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v2"><mxGeometry x="925" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v12" value="Система в памяти; клавиатура и мышь — только подключённые при загрузке" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v3"><mxGeometry x="1115" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v13" value="Окно «Подключение»: сеть; экран открыт для DHCP, DNS и сервера" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v3"><mxGeometry x="1305" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v14" value="Ответ сервера подменён?" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;spacing=14;" vertex="1" parent="v3"><mxGeometry x="1490" y="20" width="170" height="110" as="geometry"/></mxCell><mxCell id="v15" value="Запертое окно портала → вход в сеть гостиницы" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v2"><mxGeometry x="1685" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v16" value="Носитель отозван?" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;spacing=14;" vertex="1" parent="v4"><mxGeometry x="1870" y="20" width="170" height="110" as="geometry"/></mxCell><mxCell id="v17" value="Стирание (П8)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v3"><mxGeometry x="2065" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v18" value="Вводит TOTP" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v2"><mxGeometry x="2255" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v19" value="Одной операцией: TOTP, звено, ВМ, минимальный выпуск; на любой отказ — один ответ" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v4"><mxGeometry x="2445" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v20" value="Всё в порядке?" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;spacing=14;" vertex="1" parent="v4"><mxGeometry x="2630" y="20" width="170" height="110" as="geometry"/></mxCell><mxCell id="v21" value="Клон — блокировка; старый выпуск — принудительное обновление (П6)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v3"><mxGeometry x="2825" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v22" value="Этап 1: доступ к VPN только до DMZ (сертификат на сутки или пароль ViPNet)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v4"><mxGeometry x="3015" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v23" value="Туннель ViPNet (если есть у компании) или OpenVPN" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v5"><mxGeometry x="3205" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v24" value="Этап 2, через туннель: профили, подписанные администратором носителя" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v4"><mxGeometry x="3395" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v25" value="Выбор цели; проверка доступности" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v3"><mxGeometry x="3585" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v26" value="Вводит пароль рабочего места" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v2"><mxGeometry x="3775" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v27" value="Сеанс на весь экран; отпечаток сверен с профилем" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v6"><mxGeometry x="3965" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v28" value="В фоне: журнал на сервер, плановое обновление" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v3"><mxGeometry x="4155" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v29" value="Выход: «Подключиться снова» без TOTP в течение суток — или выключить" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v2"><mxGeometry x="4345" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v30" value="" style="ellipse;html=1;shape=doubleEllipse;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="v2"><mxGeometry x="4598" y="58" width="34" height="34" as="geometry"/></mxCell><mxCell id="e31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v7" target="v8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v8" target="v9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" so