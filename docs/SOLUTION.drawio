;" edge="1" parent="1" source="v16" target="v18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v18" target="v19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v19" target="v20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e45" value="нет" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v20" target="v21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e46" value="да" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v20" target="v22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e47" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v22" target="v23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e48" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v23" target="v24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e49" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v24" target="v25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e50" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v25" target="v26"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e51" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v26" target="v27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e52" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v27" target="v28"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e53" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v28" target="v29"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e54" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v29" target="v30"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v55" value="На каждом шаге сетевой экран носителя открывает ровно то, что нужно: нет сети → портал → сервер ответил → VPN поднят. Входящие соединения закрыты всегда." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="860" width="420" height="67" as="geometry"/></mxCell><mxCell id="v56" value="Блокировку сеанса по бездействию обеспечивает рабочее место — вне ответственности решения (1.5). Остаток: «Подключиться снова» у оставленного носителя упирается в пароль рабочего места." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460" y="860" width="420" height="67" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="П6 Обновление" id="p9"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2780" pageHeight="1010" math="0" shadow="0" adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="&lt;b&gt;П6. Обновление системы носителя (4.3.3)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="2700" height="50" as="geometry"/></mxCell><mxCell id="v2" value="Сервер доступа" style="swimlane;horizontal=0;startSize=150;fillColor=#F5F5F5;html=1;fontSize=13;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="2700" height="150" as="geometry"/></mxCell><mxCell id="v3" value="Носитель" style="swimlane;horizontal=0;startSize=150;fillColor=#E8F4F8;html=1;fontSize=13;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="240" width="2700" height="150" as="geometry"/></mxCell><mxCell id="v4" value="Загрузчик носителя" style="swimlane;horizontal=0;startSize=150;fillColor=#FFF0E6;html=1;fontSize=13;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="390" width="2700" height="150" as="geometry"/></mxCell><mxCell id="v5" value="Сотрудник" style="swimlane;horizontal=0;startSize=150;fillColor=#E8F5E9;html=1;fontSize=13;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="540" width="2700" height="150" as="geometry"/></mxCell><mxCell id="v6" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="v2"><mxGeometry x="230" y="60" width="30" height="30" as="geometry"/></mxCell><mxCell id="v7" value="Выпуск ниже минимального?" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;spacing=14;" vertex="1" parent="v2"><mxGeometry x="350" y="20" width="170" height="110" as="geometry"/></mxCell><mxCell id="v8" value="Принудительное: вместо доступа — «обновись»" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v2"><mxGeometry x="545" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v9" value="Качает сразу, по сеансу, без VPN; работать нельзя до перезагрузки" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v3"><mxGeometry x="735" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v10" value="Плановое: при входе называет назначенный выпуск" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v2"><mxGeometry x="925" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v11" value="После поднятия VPN качает в фоне в свободный слот (докачка, низкий приоритет)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v3"><mxGeometry x="1115" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v12" value="Проверка подписи, хешей, целостности образа; выключение заблокировано на время записи" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v3"><mxGeometry x="1305" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v13" value="«Применится при следующем включении»" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v5"><mxGeometry x="1495" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v14" value="Следующая загрузка: новый слот пробуется ограниченное число раз" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v4"><mxGeometry x="1685" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v15" value="Загрузилась?" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;spacing=14;" vertex="1" parent="v4"><mxGeometry x="1870" y="20" width="170" height="110" as="geometry"/></mxCell><mxCell id="v16" value="Слот отмечен проверенным, минимальный выпуск поднят — старый не загрузится" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v3"><mxGeometry x="2065" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v17" value="Три неудачи — откат на прежний слот, событие администратору" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v4"><mxGeometry x="2255" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v18" value="" style="ellipse;html=1;shape=doubleEllipse;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="v3"><mxGeometry x="2508" y="58" width="34" height="34" as="geometry"/></mxCell><mxCell id="e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v6" target="v7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e20" value="да" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v7" target="v8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v8" target="v9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="v9" target="v12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e23" value="нет" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="v7" target="v10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v10" target="v11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v11" target="v12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v12" target="v13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v13" target="v14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v14" target="v15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e29" value="да" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v15" target="v16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e30" value="нет" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v15" target="v17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v16" target="v18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v17" target="v18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v33" value="Принудительное обновление — без льготы: минимальный выпуск поднимают ради закрытия уязвимости, работать со старым нельзя, даже если загрузка займёт час." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="710" width="420" height="67" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="П7 Восстановление" id="p10"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3350" pageHeight="1010" math="0" shadow="0" adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="&lt;b&gt;П7. Восстановление по звонку (4.3.4, 4.1.16)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="3270" height="50" as="geometry"/></mxCell><mxCell id="v2" value="Сотрудник" style="swimlane;horizontal=0;startSize=150;fillColor=#F5F5F5;html=1;fontSize=13;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="3270" height="150" as="geometry"/></mxCell><mxCell id="v3" value="Носитель" style="swimlane;horizontal=0;startSize=150;fillColor=#E8F4F8;html=1;fontSize=13;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="240" width="3270" height="150" as="geometry"/></mxCell><mxCell id="v4" value="Администратор носителя" style="swimlane;horizontal=0;startSize=150;fillColor=#FFF0E6;html=1;fontSize=13;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="390" width="3270" height="150" as="geometry"/></mxCell><mxCell id="v5" value="Программа администратора" style="swimlane;horizontal=0;startSize=150;fillColor=#E8F5E9;html=1;fontSize=13;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="540" width="3270" height="150" as="geometry"/></mxCell><mxCell id="v6" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="v3"><mxGeometry x="230" y="60" width="30" height="30" as="geometry"/></mxCell><mxCell id="v7" value="Забыта фраза (попытки этой загрузки исчерпаны) или новая машина сверх лимита" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v3"><mxGeometry x="355" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v8" value="Показывает запрос: 12 знаков с контрольной суммой" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v3"><mxGeometry x="545" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v9" value="Звонит администратору носителя, диктует запрос" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v2"><mxGeometry x="735" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v10" value="Личность подтверждена?" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;spacing=14;" vertex="1" parent="v4"><mxGeometry x="920" y="20" width="170" height="110" as="geometry"/></mxCell><mxCell id="v11" value="Выводит код из секрета носителя" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v5"><mxGeometry x="1115" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v12" value="Отказ" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v4"><mxGeometry x="1305" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v13" value="Диктует код" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v4"><mxGeometry x="1495" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v14" value="Вводит код (три попытки; до принятия на носителе ничего не меняется)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v2"><mxGeometry x="1685" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v15" value="Код принят?" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;spacing=14;" vertex="1" parent="v3"><mxGeometry x="1870" y="20" width="170" height="110" as="geometry"/></mxCell><mxCell id="v16" value="Три неудачи: снова звонок администратору" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v2"><mxGeometry x="2065" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v17" value="Удаляет машинные слоты: их ключи выведены из старой фразы" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v3"><mxGeometry x="2255" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v18" value="Задаёт новую фразу дважды" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v2"><mxGeometry x="2445" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v19" value="Удалить слот старой фразы → записать новую → удалить слот восстановления (новой фразой)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v3"><mxGeometry x="2635" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v20" value="Перезагрузка; текущий компьютер регистрируется штатно, с вопросом" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v3"><mxGeometry x="2825" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v21" value="" style="ellipse;html=1;shape=doubleEllipse;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="v3"><mxGeometry x="3078" y="58" width="34" height="34" as="geometry"/></mxCell><mxCell id="e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v6" target="v7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v7" target="v8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v8" target="v9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v9" target="v10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e26" value="нет" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v10" target="v12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e27" value="да" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v10" target="v11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v11" target="v13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v13" target="v14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v14" target="v15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e31" value="нет" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v15" target="v16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e32" value="да" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v15" target="v17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v17" target="v18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v18" target="v19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v19" target="v20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v20" target="v21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v37" value="Работает без сети. Порядок шагов исключает носитель с двумя рабочими фразами при сбое на последнем шаге. Слоты восстановления кончились — перевыпуск. Заблокированный PIN токена-носителя — отложено до Рутокен ЭЦП 3.0 Flash (4.1.16а)." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="710" width="420" height="82" as="geometry"/></mxCell><mxCell id="v38" value="Новая фраза — по правилу записи (своя от 10 знаков), носитель предлагает сгенерированную. Лимит попыток — на одну загрузку; ключ не удаляется: перебор по копии идёт офлайн, а постоянный счётчик дал бы любому «сжечь» фразу (решения 08.10)." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460" y="710" width="420" height="82" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="П8 Отзыв" id="p11"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2020" pageHeight="1160" math="0" shadow="0" adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="&lt;b&gt;П8. Отзыв носителя и стирание (4.1.17, 4.3.5)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1940" height="50" as="geometry"/></mxCell><mxCell id="v2" value="Администратор носителя / владелец корня" style="swimlane;horizontal=0;startSize=150;fillColor=#F5F5F5;html=1;fontSize=13;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="1940" height="150" as="geometry"/></mxCell><mxCell id="v3" value="Программа администратора" style="swimlane;horizontal=0;startSize=150;fillColor=#E8F4F8;html=1;fontSize=13;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="240" width="1940" height="150" as="geometry"/></mxCell><mxCell id="v4" value="Сервер доступа" style="swimlane;horizontal=0;startSize=150;fillColor=#FFF0E6;html=1;fontSize=13;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="390" width="1940" height="150" as="geometry"/></mxCell><mxCell id="v5" value="VPN-шлюз" style="swimlane;horizontal=0;startSize=150;fillColor=#E8F5E9;html=1;fontSize=13;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="540" width="1940" height="150" as="geometry"/></mxCell><mxCell id="v6" value="Носитель" style="swimlane;horizontal=0;startSize=150;fillColor=#FFF9E6;html=1;fontSize=13;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="690" width="1940" height="150" as="geometry"/></mxCell><mxCell id="v7" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="v2"><mxGeometry x="230" y="60" width="30" height="30" as="geometry"/></mxCell><mxCell id="v8" value="Свойства носителя → «Отозвать» (предупреждение о необратимости)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v2"><mxGeometry x="355" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v9" value="Распоряжение об отзыве, подписанное администратором носителя (или корнем — аварийно)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v3"><mxGeometry x="545" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v10" value="Отметка отзыва; сертификаты носителя — в список отзыва" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v4"><mxGeometry x="735" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v11" value="Раз в минуту забирает список; открытый туннель рвётся до ~17 минут" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v5"><mxGeometry x="925" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v12" value="При выходе в сеть получает распоряжение и проверяет подпись администратора" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v6"><mxGeometry x="1115" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v13" value="Стирает по порядку: ключи томов → данные → загрузку → разметку; у токена — и ключи в чипе" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v6"><mxGeometry x="1305" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v14" value="«Отзыв доставлен»: время и адрес" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v4"><mxGeometry x="1495" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v15" value="" style="ellipse;html=1;shape=doubleEllipse;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="v4"><mxGeometry x="1748" y="58" width="34" height="34" as="geometry"/></mxCell><mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v7" target="v8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v8" target="v9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v9" target="v10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v10" target="v11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v10" target="v12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v12" target="v13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v13" target="v14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v14" target="v15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v24" value="Носитель вернулся физически — программа стирает его на месте без сети." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="860" width="420" height="53" as="geometry"/></mxCell><mxCell id="v25" value="Распоряжение об отзыве подписывает администратор носителя (или корень), сервер только передаёт — взломанный сервер не сотрёт парк (Н2)." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460" y="860" width="420" height="67" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="П9 Передача" id="p12"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2970" pageHeight="1160" math="0" shadow="0" adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="&lt;b&gt;П9. Передача носителей и сверка (2.4, 4.1.19, 4.1.20)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="2890" height="50" as="geometry"/></mxCell><mxCell id="v2" value="Отдающий администратор" style="swimlane;horizontal=0;startSize=150;fillColor=#F5F5F5;html=1;fontSize=13;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="2890" height="150" as="geometry"/></mxCell><mxCell id="v3" value="Принимающий администратор" style="swimlane;horizontal=0;startSize=150;fillColor=#E8F4F8;html=1;fontSize=13;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="240" width="2890" height="150" as="geometry"/></mxCell><mxCell id="v4" value="Владелец корня" style="swimlane;horizontal=0;startSize=150;fillColor=#FFF0E6;html=1;fontSize=13;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="390" width="2890" height="150" as="geometry"/></mxCell><mxCell id="v5" value="Программа администратора" style="swimlane;horizontal=0;startSize=150;fillColor=#E8F5E9;html=1;fontSize=13;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="540" width="2890" height="150" as="geometry"/></mxCell><mxCell id="v6" value="Сервер доступа" style="swimlane;horizontal=0;startSize=150;fillColor=#FFF9E6;html=1;fontSize=13;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="690" width="2890" height="150" as="geometry"/></mxCell><mxCell id="v7" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="v2"><mxGeometry x="230" y="60" width="30" height="30" as="geometry"/></mxCell><mxCell id="v8" value="Контейнер отдающего доступен?" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;spacing=14;" vertex="1" parent="v2"><mxGeometry x="350" y="20" width="170" height="110" as="geometry"/></mxCell><mxCell id="v9" value="Показывает свой код обмена" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v3"><mxGeometry x="545" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v10" value="Отдающий выбирает носители (или все) и конфигурации" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v5"><mxGeometry x="735" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v11" value="Посылка: записи носителей с секретами + конфигурации; шифр на получателя, подпись отдающего" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v5"><mxGeometry x="925" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v12" value="Принимает и подписывает" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v3"><mxGeometry x="1115" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v13" value="Меняет администратора носителей по двум подписям" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v6"><mxGeometry x="1305" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v14" value="Отзывает рабочий ключ утерянного контейнера" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v4"><mxGeometry x="1495" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v15" value="Режим нулевого администратора: депонированные записи → расшифровка → шифр на получателя" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v5"><mxGeometry x="1685" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v16" value="Подписывает передачу корнем" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v4"><mxGeometry x="1875" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v17" value="Меняет администратора носителей" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v6"><mxGeometry x="2065" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v18" value="Сверка при открытии контейнера получателя: «переданы вам» → принять" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v5"><mxGeometry x="2255" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v19" value="Переподписывает профили и действующие выпуски своим ключом" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v3"><mxGeometry x="2445" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v20" value="" style="ellipse;html=1;shape=doubleEllipse;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="v3"><mxGeometry x="2698" y="58" width="34" height="34" as="geometry"/></mxCell><mxCell id="e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v7" target="v8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e22" value="да: добровольно" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v8" target="v9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v9" target="v10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v10" target="v11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v11" target="v12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v12" target="v13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="v13" target="v18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e28" value="нет: принудительно" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v8" target="v14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v14" target="v15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v15" target="v16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v16" target="v17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v17" target="v18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v18" target="v19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v19" target="v20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v35" value="Мигрирует содержимое контейнера, а не личность: ключи и сертификат отдающего не передаются. Сообщение «отформатирован чужим администратором» только уведомляет — сервер носитель не отключает." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="860" width="420" height="67" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="П10 Хищение корня" id="p13"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2780" pageHeight="1160" math="0" shadow="0" adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="&lt;b&gt;П10. Хищение основного корня (4.1.6)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="2700" height="50" as="geometry"/></mxCell><mxCell id="v2" value="Владелец корня" style="swimlane;horizontal=0;startSize=150;fillColor=#F5F5F5;html=1;fontSize=13;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="2700" height="150" as="geometry"/></mxCell><mxCell id="v3" value="Программа (режим нулевого администратора)" style="swimlane;horizontal=0;startSize=150;fillColor=#E8F4F8;html=1;fontSize=13;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="240" width="2700" height="150" as="geometry"/></mxCell><mxCell id="v4" value="Новый токен" style="swimlane;horizontal=0;startSize=150;fillColor=#FFF0E6;html=1;fontSize=13;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="390" width="2700" height="150" as="geometry"/></mxCell><mxCell id="v5" value="Сервер доступа" style="swimlane;horizontal=0;startSize=150;fillColor=#E8F5E9;html=1;fontSize=13;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="540" width="2700" height="150" as="geometry"/></mxCell><mxCell id="v6" value="Носители" style="swimlane;horizontal=0;startSize=150;fillColor=#FFF9E6;html=1;fontSize=13;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="690" width="2700" height="150" as="geometry"/></mxCell><mxCell id="v7" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="v2"><mxGeometry x="230" y="60" width="30" height="30" as="geometry"/></mxCell><mxCell id="v8" value="Открывает резервную копию (файл + фраза) → «Основной корень похищен»" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v2"><mxGeometry x="355" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v9" value="Смена PIN; новый ключ корня рождается в чипе" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v4"><mxGeometry x="545" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v10" value="Новые ключи слота 0 и депонирования → в токен и в перезаписанный файл" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v3"><mxGeometry x="735" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v11" value="Подтверждает глазами каждую строку перечня администраторов" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v2"><mxGeometry x="925" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v12" value="Документ замены подписан резервным корнем: старый отозван, новый основной, перечень" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v3"><mxGeometry x="1115" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v13" value="Применяет сразу: старый корень исключён, команды вне перечня отвергаются" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v5"><mxGeometry x="1305" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v14" value="Перешифровывает депонированные записи на новый ключ" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v3"><mxGeometry x="1495" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v15" value="Новый слот 0; смена ключа данных и секретов" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v5"><mxGeometry x="1685" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v16" value="Документ замены — в карточку и в резервные места поиска" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v5"><mxGeometry x="1875" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v17" value="При первом обращении применяют замену раньше любого документа" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v6"><mxGeometry x="2065" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v18" value="Новый паспорт организации" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="v2"><mxGeometry x="2255" y="35" width="160" height="80" as="geometry"/></mxCell><mxCell id="v19" value="" style="ellipse;html=1;shape=doubleEllipse;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="v2"><mxGeometry x="2508" y="58" width="34" height="34" as="geometry"/></mxCell><mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v7" target="v8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v8" target="v9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v9" target="v10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v10" target="v11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v11" target="v12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v12" target="v13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v13" target="v14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" sou